{
  "manifest_version": 3,
  "name": "Yuqi Application Copilot",
  "version": "0.3.0",
  "description": "Review and fill applications, sign-up forms, and logins through Yuqi's authenticated MCP platform.",
  "icons": {
    "16": "icons/yuqi-16.png",
    "32": "icons/yuqi-32.png",
    "48": "icons/yuqi-48.png",
    "128": "icons/yuqi-128.png"
  },
  "permissions": ["activeTab", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.yuqi.site/*"],
  "action": {
    "default_title": "Yuqi Application Copilot",
    "default_icon": {
      "16": "icons/yuqi-16.png",
      "32": "icons/yuqi-32.png",
      "48": "icons/yuqi-48.png",
      "128": "icons/yuqi-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}

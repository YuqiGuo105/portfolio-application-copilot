{
  "manifest_version": 3,
  "name": "Yuqi Application Copilot",
  "version": "0.5.4",
  "description": "Review and autofill job applications from a private profile and resume; sensitive answers and final submission stay manual.",
  "icons": {
    "16": "icons/yuqi-16.png",
    "32": "icons/yuqi-32.png",
    "48": "icons/yuqi-48.png",
    "128": "icons/yuqi-128.png"
  },
  "permissions": ["activeTab", "favicon", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.yuqi.site/*",
    "https://iyvhmpdfrnznxgyvvkvx.supabase.co/*"
  ],
  "action": {
    "default_title": "Yuqi Application Copilot",
    "default_icon": {
      "16": "icons/yuqi-16.png",
      "32": "icons/yuqi-32.png",
      "48": "icons/yuqi-48.png",
      "128": "icons/yuqi-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
